<?xml version="1.0" encoding="UTF-8"?>
<!-- Εξαιρέσεις SpotBugs. Κάθε νέα εξαίρεση χρειάζεται αιτιολόγηση στο PR. -->
<FindBugsFilter>
    <!-- Συνηθισμένα false positives σε JPA entities / Spring beans που κρατούν mutable αντικείμενα -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>
</FindBugsFilter>
